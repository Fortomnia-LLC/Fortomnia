{
  "cli": {
    "version": ">= 21.7.0",
    "appVersionSource": "remote"
  },
 "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview"
    },
  "ios-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production"
    }
   },
  "submit": {
    "production": {}
  }
}
