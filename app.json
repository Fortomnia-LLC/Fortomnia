{
  "expo": {
    "name": "Fortomnia",
    "description": "Track training, nutrition, supplements, and performance in one private system.",
    "slug": "fortomnia",
    "owner": "body-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fortomnia",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": { "image": "./assets/splash-icon.png", "resizeMode": "contain", "backgroundColor": "#0B0B0B" },
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.grc0830source.fortomnia", "infoPlist": { "ITSAppUsesNonExemptEncryption": false } },
    "android": { "package": "com.grc0830source.fortomnia", "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#0B0B0B" }, "edgeToEdgeEnabled": true, "predictiveBackGestureEnabled": false },
    "web": { "favicon": "./assets/favicon.png" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-camera", { "cameraPermission": "Allow Fortomnia to use your camera to scan food barcodes.", "recordAudioAndroid": false }],
      "expo-notifications",
      "./modules/fortomnia-health/app.plugin.js"
    ],
    "experiments": { "typedRoutes": true },
    "extra": { "router": {}, "eas": { "projectId": "48a69035-01c0-431f-8543-f47065f75bba" } }
  }
}
